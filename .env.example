# Public site URL (no trailing slash). Used for Stripe success/cancel URLs, sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe ────────────────────────────────────────────────────────────────
# Benchline is sold through Kaivaryn LLC's Stripe account. Create SEPARATE Benchline
# products/prices there (never reuse other Kaivaryn prices). Placeholders only — no real values here.
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Benchline's own Customer Portal configuration (non-secret bpc_… id). Optional; without it
# Stripe uses the account's default portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_xxx
# No publishable key is needed: checkout is a server-created Checkout Session and the
# browser is redirected to session.url (no Stripe.js).

# Price IDs are OPTIONAL. By default checkout finds each price by its Stripe lookup_key
# (see README "Stripe setup"), so no per-product env var is needed. Set these only to
# override a lookup key with a specific Price ID:
# STRIPE_PRICE_CORE=price_xxx            # Core Kit, $199 one-time      (lookup_key benchline_core_kit)
# STRIPE_PRICE_MEMBERSHIP=price_xxx      # Benchline Pro, $29/month     (lookup_key benchline_updates_monthly)
# STRIPE_PRICE_BUNDLE=price_xxx          # Core + 3 Months Pro, $249    (lookup_key benchline_core_bundle)
# Any other product: STRIPE_PRICE_<PRODUCT_ID_IN_UPPER_SNAKE>, e.g.
# STRIPE_PRICE_CLEANING_KIT=price_xxx
# STRIPE_PRICE_CORE_PLUS_LAWN_CARE=price_xxx
# STRIPE_PRICE_PRICING_CALCULATOR_PACK=price_xxx

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
# Required for: webhook order fulfillment, Pro subscription sync, analytics events,
# billing portal lookup, and the founder dashboard.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Founder dashboard allowlist (comma-separated emails)
FOUNDER_EMAIL=you@example.com

# Optional: OpenAI for dashboard AI analyst (falls back to rule-based summary)
OPENAI_API_KEY=

# Download signing (random 32+ char secret)
DOWNLOAD_SIGNING_SECRET=change-me-to-a-long-random-string
